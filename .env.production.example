# Production Environment Variables Template

# Next.js Configuration
NEXT_PUBLIC_BASE_URL=https://myleskameron.com

# Notion API Configuration
NOTION_API_KEY=your_notion_api_key
NOTION_DATABASE_ID=your_database_id
NOTION_COUNTRIES_DATABASE_ID=your_countries_database_id
NOTION_REVENUE_DATABASE_ID=your_revenue_database_id

# Resend API Configuration
RESEND_API_KEY=your_resend_api_key

# Beehiiv API Configuration
BEEHIIV_API_KEY=your_beehiiv_api_key
BEEHIIV_PUBLICATION_ID=pub_your_publication_id

# Blueprint Configuration
BLUEPRINT_DOWNLOAD_URL=https://myleskameron.com/downloads/blueprint-starter-pack/index.html