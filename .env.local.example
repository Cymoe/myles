# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-09-16"

# Notion API Configuration
# Get your API key from: https://www.notion.so/my-integrations
NOTION_API_KEY="your_notion_api_key_here"

# The database ID is the part of the URL after the workspace name
# Example: https://www.notion.so/myworkspace/a8aec43384f447ed84390e8e42c2e089?v=...
# Database ID would be: a8aec43384f447ed84390e8e42c2e089
NOTION_DATABASE_ID="your_database_id_here"

# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_API_KEY_HERE"

# Optional: Base URL for email links (defaults to https://myleskameron.com)
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"